<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Preview for Windows. tools/package.ps1 sets Identity/@Version from Cargo.toml.
  Publisher is a placeholder for local test signing. Replace it with the Partner Center
  publisher (Store) or the code-signing certificate subject (direct download). See docs/packaging.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 rescap">

  <Identity Name="PreviewForWindows" Publisher="CN=Preview for Windows Test" Version="0.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Preview for Windows</DisplayName>
    <PublisherDisplayName>Preview for Windows</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="preview-for-windows.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Preview for Windows"
        Description="View and edit PDFs and images."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="pdf" Parameters="&quot;%1&quot;" MultiSelectModel="Player">
            <uap:DisplayName>PDF document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="combine" Parameters="--combine &quot;%1&quot;" MultiSelectModel="Player">Combine into PDF</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="image" Parameters="&quot;%1&quot;" MultiSelectModel="Player">
            <uap:DisplayName>Image</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="convert" Parameters="--convert &quot;%1&quot;" MultiSelectModel="Player">Convert</uap3:Verb>
              <uap3:Verb Id="resize" Parameters="--resize &quot;%1&quot;" MultiSelectModel="Player">Resize</uap3:Verb>
              <uap3:Verb Id="combine" Parameters="--combine &quot;%1&quot;" MultiSelectModel="Player">Combine into PDF</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
